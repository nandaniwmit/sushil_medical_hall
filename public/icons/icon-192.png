<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="medGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0A8F6A" />
      <stop offset="100%" stop-color="#0284c7" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000" flood-opacity="0.15" />
    </filter>
  </defs>
  <rect width="512" height="512" rx="128" fill="url(#medGrad)" />
  <g filter="url(#shadow)">
    <!-- White Shield / Medical Cross Background -->
    <rect x="96" y="96" width="320" height="320" rx="48" fill="#ffffff" />
    <!-- Medical Cross in Emerald & Blue -->
    <rect x="220" y="146" width="72" height="220" rx="16" fill="#0A8F6A" />
    <rect x="146" y="220" width="220" height="72" rx="16" fill="#0A8F6A" />
    <!-- Pulse Line Accent -->
    <path d="M160 256 L200 256 L226 200 L256 312 L286 230 L312 256 L352 256" fill="none" stroke="#ffffff" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" />
    <!-- S Initial Monogram -->
    <circle cx="256" cy="256" r="32" fill="#0284c7" />
    <text x="256" y="268" font-family="Arial, sans-serif" font-size="34" font-weight="900" fill="#ffffff" text-anchor="middle">S</text>
  </g>
</svg>
